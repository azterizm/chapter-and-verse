event: sentence
data: {"citations":[{"coordinate":"uk/ukpga/1996/18/s124/1","label":"s.124(1) Employment Rights Act 1996","passage_id":"P1","url":"https://www.legislation.gov.uk/ukpga/1996/18/section/124/1"}],"sentence":{"index":0,"passage_ids":["P1"],"reasons":["GROUNDED"],"rollbacks":0,"text":"A compensatory award for unfair dismissal cannot exceed the amount specified in subsection (1ZA).","verdict":"supported"},"type":"sentence"}

event: sources
data: {"type":"sources","windows":[{"coordinate":"uk/ukpga/1996/18/s124/1","heading":"Employment Rights Act 1996, section 124(1) (Limit of compensatory award etc)","highlight":[173,231],"passage_id":"P1","source_url":"https://www.legislation.gov.uk/ukpga/1996/18/section/124/1","status":"IN_FORCE","text":"(1) The amount of— (a) any compensation awarded to a person under section 117(1) and (2), or (b) a compensatory award to a person calculated in accordance with section 123, shall not exceed the amount specified in subsection (1ZA).","version_date":"2026-07-29"},{"coordinate":"uk/ukpga/1996/18/s124/1ZA","heading":"Employment Rights Act 1996, section 124(1ZA) (Limit of compensatory award etc)","highlight":[49,139],"passage_id":"P2","source_url":"https://www.legislation.gov.uk/ukpga/1996/18/section/124/1ZA","status":"IN_FORCE","text":"(1ZA) The amount specified in this subsection is the lower of— (a) £123,543, and (b) 52 multiplied by a week’s pay of the person concerned.","version_date":"2026-07-29"},{"coordinate":"uk/ukpga/1996/18/s124/1A","heading":"Employment Rights Act 1996, section 124(1A) (Limit of compensatory award etc)","highlight":null,"passage_id":"P3","source_url":"https://www.legislation.gov.uk/ukpga/1996/18/section/124/1A","status":"IN_FORCE","text":"(1A) Subsection (1) shall not apply to compensation awarded, or a compensatory award made, to a person in a case where he is regarded as unfairly dismissed by virtue of section 100, 103A, 105(3) or 105(6A).","version_date":"2026-07-29"}]}

event: sentence
data: {"citations":[{"coordinate":"uk/ukpga/1996/18/s124/1ZA","label":"s.124(1ZA) Employment Rights Act 1996","passage_id":"P2","url":"https://www.legislation.gov.uk/ukpga/1996/18/section/124/1ZA"}],"sentence":{"index":1,"passage_ids":["P2"],"reasons":["GROUNDED"],"rollbacks":1,"text":"That amount is the lower of £123,543 and 52 multiplied by a week's pay of the person concerned.","verdict":"supported"},"type":"sentence"}

event: sentence
data: {"citations":[{"coordinate":"uk/ukpga/1996/18/s124/1A","label":"s.124(1A) Employment Rights Act 1996","passage_id":"P3","url":"https://www.legislation.gov.uk/ukpga/1996/18/section/124/1A"}],"sentence":{"index":2,"passage_ids":["P3"],"reasons":["GROUNDED"],"rollbacks":0,"text":"The limit does not apply where the person is regarded as unfairly dismissed by virtue of section 100, 103A, 105(3) or 105(6A).","verdict":"supported"},"type":"sentence"}

