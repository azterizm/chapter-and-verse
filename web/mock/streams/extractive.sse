event: sources
data: {"type":"sources","windows":[{"coordinate":"uk/ukpga/1996/18/s124/1","heading":"Employment Rights Act 1996, section 124(1) (Limit of compensatory award etc)","highlight":[173,231],"passage_id":"P1","source_url":"https://www.legislation.gov.uk/ukpga/1996/18/section/124/1","status":"IN_FORCE","text":"(1) The amount of— (a) any compensation awarded to a person under section 117(1) and (2), or (b) a compensatory award to a person calculated in accordance with section 123, shall not exceed the amount specified in subsection (1ZA).","version_date":"2026-07-29"},{"coordinate":"uk/ukpga/1996/18/s124/1ZA","heading":"Employment Rights Act 1996, section 124(1ZA) (Limit of compensatory award etc)","highlight":[49,139],"passage_id":"P2","source_url":"https://www.legislation.gov.uk/ukpga/1996/18/section/124/1ZA","status":"IN_FORCE","text":"(1ZA) The amount specified in this subsection is the lower of— (a) £123,543, and (b) 52 multiplied by a week’s pay of the person concerned.","version_date":"2026-07-29"}]}

