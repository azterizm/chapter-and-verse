# Template for /etc/chapter-and-verse/engine.env (outside the repository, mode 0640 root:deploy).
# Copy it there and fill it in on the host. Never commit the filled-in file.
# Also the list of Space secrets and variables for the Hugging Face standby (Slice 4).

# Artefacts: public Hugging Face Dataset, pinned to a commit.
HF_DATASET=OWNER/chapter-and-verse-artefacts
HF_REVISION=0000000000000000000000000000000000000000
# sha256 of corpus-manifest.json at that revision (recommended pin).
MANIFEST_SHA256=
# Clarify ranking prior; entrypoint.sh exports CLARIFY_PRIOR_PATH when clarify/clarify_prior.json is present.

# Heroku Postgres Essential-0. Heroku rotates credentials; copy the current value from
# "heroku config:get DATABASE_URL -a APP". Keep sslmode=require.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Providers. A provider whose key is empty is out of the rotation.
# Ensure AI_GATEWAY_API_KEY and GEMINI_API_KEY are also added to /etc/chapter-and-verse/engine.env on Oracle A1 when deploying.
GROQ_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_WORKER_TOKEN=
AI_GATEWAY_API_KEY=
VERCEL_MODEL=google/gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Modal SGLang endpoint (deploy/modal/serve.py) and the key its Modal Secret holds.
MODAL_URL=https://WORKSPACE--chapter-and-verse-judge-serve.modal.run
MODAL_API_KEY=
# Modal KV path (true rollback). Both files are needed; without either, Modal serves chat and the judge only.
# The serialised logit mask written by serve.py::get_mask_processor --out (deploy/README.md 3.5).
MODAL_MASK_PROCESSOR=
# tokenizer.json of the pinned model revision; empty downloads it once from Hugging Face at startup.
MODAL_TOKENIZER_JSON=

# Provider order per purpose (comma lists).
# Generation-only rule: vercel and gemini must ONLY appear in GEN_PROVIDERS, never in JUDGE_PROVIDERS in production.
# The judge stays on modal (qwen27-ar4, 99.4% error catch + KV rollback).
GEN_PROVIDERS=groq,cloudflare,vercel,gemini,modal
JUDGE_PROVIDERS=modal
# Seconds between model pin checks of Groq, Cloudflare, Vercel, and Gemini (Modal is not checked: it serves its own pinned revision).
PIN_CHECK_INTERVAL_S=86400

# Groq quota ledger limits (keep free-tier limits while Groq is on Free; raise when on Developer/paid).
GROQ_TOKENS_PER_MINUTE=8000
GROQ_TOKENS_PER_DAY=200000
GROQ_REQUESTS_PER_MINUTE=30
GROQ_REQUESTS_PER_DAY=1000

# Prompt passage budget and window cap. Set to 4000 / 12 in production so long sections (e.g. s.108(3)(ff)) are not truncated.
PREMISE_BUDGET_TOKENS=4000
MAX_PROMPT_WINDOWS=12

# Engine limits. The Worker in front caps JSON bodies at 12288 bytes and handles CORS;
# MAX_QUERY_BYTES caps the query itself.
MAX_QUERY_BYTES=4096
CORS_ORIGINS=https://chapterandverse.memonsystems.com
LOG_LEVEL=info
# Production: 1. Refuse (403) requests without the Cloudflare Access headers; only then is X-CV-Client-IP trusted.
REQUIRE_ACCESS_HEADERS=1
# Engine token bucket per client, behind the Worker's own limit: refill per minute, and bucket size.
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_BURST=10
# Daily cap on generated answers per client per UTC day; extractive answers with notice after.
DAILY_ASK_CAP=40
# Secret salt for hashing client IP addresses into daily cap keys; raw IP is never stored.
CAP_SALT=
# Global daily cap on generated answers across all users; extractive answers with notice after.
GLOBAL_DAILY_ANSWERS=400
# Maximum fraction of global daily generated answers allowed for hosting networks.
HOSTING_SHARE=0.2
# Answers computed at once (worker threads); further questions wait for a free one.
ASK_WORKERS=4
